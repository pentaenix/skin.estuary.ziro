<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<constant name="ZiroGamesBrowseBackOffset">52</constant>
	<include name="ZiroGamesBrowseBackBar">
		<control type="group" id="18902">
			<depth>DepthBars</depth>
			<visible>$EXP[ziro_games_browse_back]</visible>
			<include>OpenClose_Right</include>
			<animation effect="fade" start="0" end="100" time="200">Visible</animation>
			<animation effect="fade" start="100" end="0" time="150">Hidden</animation>
			<left>68</left>
			<top>108</top>
			<width>1780</width>
			<height>52</height>
			<control type="image">
				<left>0</left>
				<top>48</top>
				<width>100%</width>
				<height>1</height>
				<texture colordiffuse="55FFFFFF">colors/white.png</texture>
			</control>
			<control type="button" id="18903">
				<left>0</left>
				<top>4</top>
				<width>460</width>
				<height>40</height>
				<label>&#x00AB;  $INFO[Container.Property(ZiroGames.BrowseBackLabel)]</label>
				<font>font12</font>
				<align>left</align>
				<textoffsetx>20</textoffsetx>
				<texturefocus border="12" colordiffuse="button_focus">buttons/button-fo.png</texturefocus>
				<texturenofocus border="12">buttons/button-nofo.png</texturenofocus>
				<onclick>Action(Back)</onclick>
				<onleft>18903</onleft>
				<onright condition="Control.IsVisible(500)">500</onright>
				<onright condition="Control.IsVisible(54)">54</onright>
				<onright condition="Control.IsVisible(50)">50</onright>
				<ondown condition="Control.IsVisible(500)">500</ondown>
				<ondown condition="Control.IsVisible(54)">54</ondown>
				<ondown condition="Control.IsVisible(50)">50</ondown>
			</control>
		</control>
	</include>
	<include name="ZiroGamesBrowseGridSlide">
		<animation effect="slide" end="0,52" time="0" condition="$EXP[ziro_games_browse_back] + Container.Content(games)">Conditional</animation>
	</include>
</includes>
