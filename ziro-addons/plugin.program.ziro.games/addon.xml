<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.program.ziro.games" name="Games" version="0.7.2" provider-name="Ziro">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.ziro.games.launcher" version="0.2.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.script" library="clear_cache.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Game catalog hub with RetroBat launch.</summary>
    <description lang="en_GB">Open RetroBat from Kodi to play your collection. Kodi keeps artwork and metadata; RetroBat handles gameplay.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
  </extension>
</addon>
