  <section id="plugin.program.ziro.games">
    <category id="sources" label="Sources" help="Legacy default ROM folders. Prefer Sources in the Ziro Games menu.">
      <group id="1" label="Legacy folders">
        <setting id="source_gamecube" type="path" label="Legacy/default GameCube folder" help="">
          <level>0</level>
          <default/>
          <constraints>
            <writable>false</writable>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="path">
            <heading>Legacy/default GameCube folder</heading>
          </control>
        </setting>
        <setting id="source_wii" type="path" label="Legacy/default Wii folder" help="">
