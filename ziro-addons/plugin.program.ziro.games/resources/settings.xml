    <category id="metadata" label="Metadata" help="Artwork and metadata providers.">
      <group id="1" label="SteamGridDB">
        <setting id="steamgriddb_api_key" type="string" label="SteamGridDB API key" help="Create a free key at steamgriddb.com profile preferences.">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>SteamGridDB API key</heading>
            <hidden>true</hidden>
          </control>
        </setting>
        <setting id="metadata_fetch_fanart" type="boolean" label="Download hero fanart from SteamGridDB" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="metadata_fetch_logos" type="boolean" label="Download logos from SteamGridDB" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="metadata_fetch_on_scan" type="boolean" label="Offer artwork fetch after scan" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="2" label="Optional fallbacks">
        <setting id="screenscraper_user" type="string" label="ScreenScraper username (optional fallback)" help="">
          <level>2</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>ScreenScraper username</heading>
          </control>
        </setting>
        <setting id="screenscraper_password" type="string" label="ScreenScraper password" help="">
          <level>2</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>ScreenScraper password</heading>
            <hidden>true</hidden>
          </control>
        </setting>
        <setting id="igdb_client_id" type="string" label="IGDB client id (optional fallback)" help="">
          <level>2</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>IGDB client id</heading>
          </control>
        </setting>
        <setting id="igdb_client_secret" type="string" label="IGDB client secret" help="">
          <level>2</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>IGDB client secret</heading>
            <hidden>true</hidden>
